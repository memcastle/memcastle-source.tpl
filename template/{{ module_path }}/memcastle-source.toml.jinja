format = 1

[source]
name = "{{ module_name }}"
version = "{{ version }}"
description = "{{ module_description }}"

[compatibility]
contract = "0.4.0"
memcastle = "{{ memcastle }}"

[capabilities]
incremental = true

# The host only allows access to the chosen directory.
[permissions.filesystem]
read = ["locator"]

[build]
command = ["cargo", "build", "--release", "--target", "wasm32-wasip2", "--target-dir", "target"]
output = "target/wasm32-wasip2/release/{{ crate_name }}.wasm"

[test]
fixtures = "fixtures"
